{
  "name": "polox_ai",
  "type": "module",
  "version": "2.1.0",
  "packageManager": "pnpm@10.10.0",
  "description": "An open-source, agent-native platform for multimodal AI generation, built on DeepSeek Harness. Every interaction lives in agent conversations and an infinite canvas, unifying creation, generation, and editing.",
  "author": "Dian Pratama <dianpratama2@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/saihhold-zhao/polox_ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saihhold-zhao/polox_ai.git"
  },
  "keywords": [
    "ai",
    "creative-workspace",
    "image-generation",
    "video-generation",
    "infinite-canvas",
    "openrouter",
    "fal",
    "sqlite",
    "nuxt",
    "vue"
  ],
  "main": "./nuxt.config.ts",
  "files": [
    "app.vue",
    "components",
    "components.json",
    "composables",
    "constants",
    "layouts",
    "lib",
    "nuxt.config.ts",
    "pages",
    "types"
  ],
  "engines": {
    "node": ">=22.20.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "eslint --fix .",
    "release": "release-it",
    "test:sqlite": "node --experimental-transform-types --test scripts/test-sqlite.mjs scripts/test-agent-history.mjs scripts/test-local-data-migration.mjs scripts/test-local-generation-queue.mjs",
    "test:media": "node --experimental-transform-types --test scripts/test-local-media.mjs scripts/test-agent-upload.mjs scripts/test-image-text-editor.mjs scripts/test-media-export.mjs",
    "browser:install": "playwright install chromium",
    "browser:install:linux": "playwright install --with-deps chromium",
    "test:skills": "node --experimental-strip-types --no-warnings --test scripts/test-skill-creator.mjs scripts/test-skill-category.mjs scripts/test-skill-cover.mjs scripts/test-set-skill-cover-tool.mjs",
    "test:llm-images": "node --experimental-strip-types --no-warnings --test scripts/test-llm-image-budget.mjs",
    "test:agent": "node --test scripts/test-agent-prompt.mjs scripts/test-agent-chat-visibility.mjs"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@iconify-json/lucide": "^1.2.68",
    "@iconify-json/radix-icons": "^1.2.5",
    "@internationalized/date": "^3.10.0",
    "@napi-rs/canvas": "^1.0.9",
    "@number-flow/vue": "^0.4.8",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/vue-table": "^8.21.3",
    "@unovis/ts": "^1.6.1",
    "@unovis/vue": "^1.6.1",
    "ajv": "^8.20.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-vue": "^8.6.0",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "ipaddr.js": "^2.5.0",
    "isomorphic-dompurify": "^4.1.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.12.3",
    "marked": "^18.0.11",
    "mingo": "^7.2.4",
    "nanoid": "^5.1.6",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.63.0",
    "reka-ui": "^2.5.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.19.0",
    "@nuxt/eslint": "^1.9.0",
    "@nuxt/fonts": "0.11.4",
    "@nuxt/icon": "^1.15.0",
    "@nuxtjs/color-mode": "^3.5.2",
    "@nuxtjs/sitemap": "^8.5.0",
    "@pinia/nuxt": "^0.5.5",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^12.8.2",
    "@vueuse/math": "^12.8.2",
    "@vueuse/nuxt": "^12.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "eslint": "^9.37.0",
    "eslint-plugin-format": "^1.0.2",
    "lucide-vue-next": "^0.482.0",
    "nuxt": "^4.1.3",
    "release-it": "^19.0.5",
    "shadcn-nuxt": "2.3.1",
    "tailwind-merge": "^2.6.0",
    "typescript": "^5.9.3",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1",
    "vue-sonner": "^2.0.9",
    "vue-tsc": "^2.2.12",
    "zod": "^3.25.76"
  }
}
